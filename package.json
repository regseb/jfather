{
  "name": "jfather",
  "version": "0.5.1",
  "description": "JSON with merge, extend and override.",
  "keywords": [
    "jfather",
    "json",
    "merge",
    "extend",
    "override",
    "front-end",
    "backend"
  ],
  "homepage": "https://github.com/regseb/jfather#readme",
  "bugs": {
    "url": "https://github.com/regseb/jfather/issues",
    "email": "regseb@gmail.com"
  },
  "license": "MIT",
  "author": "Sébastien Règne <regseb@gmail.com> (https://github.com/regseb)",
  "funding": [
    "https://buymeacoffee.com/regseb",
    "https://www.paypal.me/sebastienregne"
  ],
  "files": [
    "./src/",
    "./types/"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regseb/jfather.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "tsc --project .tsconfig_types.json",
    "lint": "metalint",
    "lint:fix": "metalint --fix",
    "lint:types": "tsc --project .tsconfig_lint.json",
    "lint:npm": "npm pack --dry-run --quiet",
    "lint:jsr": "npx jsr publish --dry-run",
    "test": "npm run test:coverage",
    "test:unit": "npm run test:unit:node",
    "test:unit:node": "node --test \"test/unit/**/*.test.js\"",
    "test:unit:bun": "bun test test/unit/",
    "test:unit:deno": "deno test --allow-net --no-check test/unit/",
    "test:coverage": "stryker run",
    "jsdocs": "typedoc --tsconfig .tsconfig_jsdocs.json",
    "clean": "node .script/clean.js"
  },
  "devDependencies": {
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-nodejs": "2.5.13",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@prantlf/jsonlint": "17.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@secretlint/secretlint-rule-github": "13.0.5",
    "@secretlint/secretlint-rule-npm": "13.0.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/node": "26.5.1",
    "@typescript-eslint/utils": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.3.10",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "jsr": "0.14.3",
    "markdownlint": "0.41.1",
    "metalint": "0.22.1",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "secretlint": "13.0.5",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "yaml-lint": "1.7.0"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
